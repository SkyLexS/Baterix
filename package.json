{
  "name": "periph-battery",
  "version": "0.1.0",
  "description": "Monitor de baterie pentru periferice, cu notificări sub un prag",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "scan": "node scanner/scan.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "node-hid": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0" },
  "build": {
    "appId": "ro.periph.battery",
    "productName": "Baterii periferice",
    "directories": { 
      "output": "dist", 
      "buildResources": "build" 
    },
    "files": ["main.js", "preload.js", "drivers/**", "renderer/**", "package.json"],
    "asarUnpack": ["**/node_modules/node-hid/**"],
    "npmRebuild": false,
    "win": {
      "target": [{ 
        "target": "nsis", 
        "arch": ["x64"] 
        }], 
        "icon": "build/icon.ico" 
      },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }

}
